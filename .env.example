# Copy this file to .env and fill in real values.
# .env is loaded automatically by python-decouple.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# stashy.app is just a friendly name to browse to instead of localhost/an IP —
# it only resolves if you map it to 127.0.0.1 in your OS hosts file:
#   Windows: C:\Windows\System32\drivers\etc\hosts
#   macOS/Linux: /etc/hosts
# Add a line: 127.0.0.1 stashy.app
# If you skip that step, just use localhost or 127.0.0.1 instead — both stay allowed.
ALLOWED_HOSTS=localhost,127.0.0.1,stashy.app

# The port Stashy.bat serves on. Change this if port 8000 is already used by
# something else on this computer (e.g. another app, or `manage.py runserver`,
# which also defaults to 8000) — then just run Stashy.bat again.
PORT=8000
