# Copy this file to .env and fill in real values.
# .env is loaded automatically by python-decouple.

SECRET_KEY=change-me-to-a-long-random-string
# Leave False for everyday use: an error then shows a friendly page, and its details go to
# logs/stashy.log. True shows Django's detailed error pages, for working on Stashy only.
DEBUG=False

# The names Stashy answers to. stashy.localhost (what Stashy.bat opens) is always allowed
# on top of these, and needs no setup: browsers send every *.localhost name to this computer.
ALLOWED_HOSTS=localhost,127.0.0.1

# The port Stashy.bat serves on. Change this if port 8000 is already used by
# something else on this computer (e.g. another app, or `manage.py runserver`,
# which also defaults to 8000) — then just run Stashy.bat again.
PORT=8000
