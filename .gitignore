# Python
__pycache__/
*.py[codz]
*$py.class

# Environments (.env holds the secret key)
.env
.env.*
!.env.example
.venv
venv/
venv.bak/

# Stashy's own data: each stash's database and backups, plus the picker's placeholder
# database. None of this is code, and it can contain real financial data.
/stashes/
/_picker.sqlite3
db.sqlite3
db.sqlite3-journal

# A safety net: a database or a backup that lands outside /stashes/ by mistake.
*.sqlite3
*.sqlite3-*
backups/

# Generated by Stashy.bat (`collectstatic`) and by the app's error log - never edited by hand.
/staticfiles/
/logs/
*.log
*.log.*

# Migrations are kept out of git for now.
**/migrations/*.py

# Coverage reports and tool caches
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/

# Editors
.idea/
.vscode/

# Claude files (CLAUDE.md is committed; CLAUDE.local.md holds this computer's own facts)
/.claude
CLAUDE.local.md

# The browser tool /visual-check uses saves screenshots and page snapshots here. They show the
# test stash's data, and a run that stops halfway would leave them behind.
/.playwright-mcp/

# Source artwork for the mascot and the icon; the app uses the copies under finance/static/.
/images/
